#usda 1.0
(
    defaultPrim = "so101_new_calib"
    doc = "Modified by Binary Core LLC, 2026: wrapper layer over the unmodified course file SO-ARM101-USD.usd (Sim-to-Real-SO-101-Workshop ce807d9); remote asset paths point at the local mirror."
    metersPerUnit = 1
    subLayers = [
        @/workspace/Sim-to-Real-SO-101-Workshop/source/sim_to_real_so101/assets/usd/SO-ARM101-USD.usd@
    ]
    upAxis = "Z"
)

over "so101_new_calib"
{
    over "Looks"
    {
        over "Aluminum_Anodized_Black"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @/workspace/assets_mirror/omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/Base/Metals/Aluminum_Anodized_Black.mdl@
            }
        }
    }
}

