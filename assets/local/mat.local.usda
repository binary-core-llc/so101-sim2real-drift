#usda 1.0
(
    defaultPrim = "World"
    doc = "Modified by Binary Core LLC, 2026: wrapper layer over the unmodified course file mat.usda (Sim-to-Real-SO-101-Workshop ce807d9); remote asset paths point at the local mirror."
    metersPerUnit = 1
    subLayers = [
        @/workspace/Sim-to-Real-SO-101-Workshop/source/sim_to_real_so101/assets/usd/mat.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Mat"
    {
        over "Looks"
        {
            over "Paper"
            {
                over "Shader"
                {
                    uniform asset info:mdl:sourceAsset = @/workspace/assets_mirror/omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/Base/Wall_Board/Paper.mdl@
                }
            }

            over "Rubber_Smooth"
            {
                over "Shader"
                {
                    uniform asset info:mdl:sourceAsset = @/workspace/assets_mirror/omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/Base/Plastics/Rubber_Smooth.mdl@
                }
            }
        }
    }
}

