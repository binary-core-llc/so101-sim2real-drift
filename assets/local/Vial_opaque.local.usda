#usda 1.0
(
    defaultPrim = "Vial"
    doc = "Modified by Binary Core LLC, 2026: wrapper layer over the unmodified course file Vial_opaque.usda (Sim-to-Real-SO-101-Workshop ce807d9); remote asset paths point at the local mirror."
    metersPerUnit = 1
    subLayers = [
        @/workspace/Sim-to-Real-SO-101-Workshop/source/sim_to_real_so101/assets/usd/Vial_opaque.usda@
    ]
    upAxis = "Z"
)

over "Vial"
{
    over "Looks"
    {
        over "Vial_plastic"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @/workspace/assets_mirror/omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/vMaterials_2/Plastic/Plastic_Thick_Translucent.mdl@
            }
        }
    }
}

